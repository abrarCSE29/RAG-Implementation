API_KEY=dev-api-key
ENABLE_API_KEY_AUTH=true
QDRANT_URL=http://localhost:6333
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Try "Qwen/Qwen2.5-0.5B-Instruct" or "Qwen/Qwen2.5-1.5B-Instruct" for high-performance small models
LLM_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct

# Hugging Face token is required for gated models (like Gemma or LLaMA), though Qwen is generally open
HF_TOKEN=""

ENABLE_RERANKING=true
ENABLE_CITATIONS=true
